<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/current_message_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/message_filters_header" android:textSize="14sp" />
    <ListView android:id="@+id/message_filters_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tap_filter_to_edit_or_delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tap_filter_to_edit_or_delete" android:textSize="14sp" android:visibility="gone" />
    <Button android:id="@+id/add_message_filter_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_message_filter_button_label" android:visibility="gone" />
    <TextView android:id="@+id/enable_message_filtering_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enable_message_filtering_note" android:textSize="14sp" />
</LinearLayout>
